# FileName={{application}}
[Build]
ImageTag=localhost/{{application}}:latest
BuildArg=UID={{appUid}}
BuildArg=GID={{appGid}}
File={{runtimePath}}/Containerfile
IgnoreFile={{runtimePath}}/dockerignore
SetWorkingDirectory={{workingPath}}
---
# FileName={{application}}
[Unit]
Description=Laravel App (Octane) container
StopWhenUnneeded={{ondemand}}
Requires={{application}}-pgsql.container {{application}}-valkey.container
After={{application}}-pgsql.container {{application}}-valkey.container
Wants={{application}}-mailpit.container {{application}}-queue.container {{application}}-schedule.container {{application}}-rustfs.container {{application}}-typesense.container {{application}}-meilisearch.container {{application}}-memcached.container {{application}}-mongodb.container

[Container]
Image={{application}}.build
AutoUpdate=local
UserNS=keep-id
ShmSize=128m
Volume={{workingPath}}:/app:rw,z,U
Volume={{application}}-config.volume:/config:rw,z,U
Volume={{application}}-data.volume:/data:rw,z,U
Volume={{application}}-cache.volume:/cache:rw,z,U
Network={{application}}.network
Network={{proxy}}.network
ExposeHostPort=8000
PublishPort=127.0.0.1:{{ondemandPort}}:8000
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
---
# FileName={{application}}-config
[Volume]
Label={{application}}-config
VolumeName=systemd-{{application}}-config
---
# FileName={{application}}-data
[Volume]
Label={{application}}-data
VolumeName=systemd-{{application}}-data
---
# FileName={{application}}-cache
[Volume]
Label={{application}}-cache
VolumeName=systemd-{{application}}-cache
---
# FileName={{application}}
[Network]
Label={{application}}
