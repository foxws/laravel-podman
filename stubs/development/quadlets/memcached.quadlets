# FileName={{application}}-memcached
[Unit]
Description=Memcached container
StopWhenUnneeded={{ondemand}}

[Container]
Image=docker.io/library/memcached:1.6
AutoUpdate=registry
Network={{application}}.network
ExposeHostPort=11211

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
