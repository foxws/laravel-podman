# FileName={{application}}-mysql
[Unit]
Description=MySQL container
StopWhenUnneeded={{ondemand}}

[Container]
Image=docker.io/library/mysql:26
AutoUpdate=registry
Environment=MYSQL_ROOT_PASSWORD=password
Environment=MYSQL_ROOT_HOST=%
Environment=MYSQL_DATABASE=laravel
Environment=MYSQL_USER=user
Environment=MYSQL_PASSWORD=password
ShmSize=256m
Volume={{application}}-mysql.volume:/var/lib/mysql:rw,Z,U
Network={{application}}.network
ExposeHostPort=3306
Notify=healthy
HealthStartupCmd=mysqladmin ping -h 127.0.0.1 --silent
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=mysqladmin ping -h 127.0.0.1 --silent
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName={{application}}-mysql
[Volume]
Label={{application}}-mysql
VolumeName=systemd-{{application}}-mysql
