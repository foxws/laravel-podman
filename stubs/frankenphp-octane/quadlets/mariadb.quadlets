# FileName={{application}}-mariadb
[Unit]
Description=MariaDB container
StopWhenUnneeded={{ondemandServices}}

[Container]
Image=docker.io/library/mariadb:13
AutoUpdate=registry
Secret={{application}}-mariadb-root-password,type=env,target=MYSQL_ROOT_PASSWORD
Environment=MYSQL_ROOT_HOST=%
Secret={{application}}-mariadb-db,type=env,target=MYSQL_DATABASE
Secret={{application}}-mariadb-user,type=env,target=MYSQL_USER
Secret={{application}}-mariadb-password,type=env,target=MYSQL_PASSWORD
ShmSize=256m
Volume={{application}}-mariadb.volume:/var/lib/mysql:rw,Z,U
Network={{application}}.network
ExposeHostPort=3306
Notify=healthy
HealthStartupCmd=healthcheck.sh --connect --innodb_initialized
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName={{application}}-mariadb
[Volume]
Label={{application}}-mariadb
VolumeName=systemd-{{application}}-mariadb
