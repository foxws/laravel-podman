# FileName={{application}}-queue
[Unit]
Description=Laravel queue worker container
After={{application}}.container
BindsTo={{application}}.container

[Container]
Image={{application}}.build
AutoUpdate=local
HealthCmd=none
Environment=PUID={{appUid}}
Environment=PGID={{appGid}}
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan queue:work --sleep=3 --tries=3 --max-time=3600"
UserNS=keep-id
ShmSize=128m
Secret={{application}}-env,target=/app/.env,mode=0400,uid={{appUid}},gid={{appGid}}
Volume={{application}}-cache.volume:/cache:rw,z
Network={{application}}.network

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
