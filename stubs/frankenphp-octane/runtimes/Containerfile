FROM docker.io/dunglas/frankenphp:latest

ARG UID=1000
ARG GID=1000
ARG NODE_VERSION=24
ARG POSTGRES_VERSION=18
ARG PHP_EXTENSIONS=""

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV PNPM_HOME="/home/docker/.local/share/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"
ENV FRANKEN_CLI="frankenphp php-cli /app/artisan"
ENV PHP_CLI="php -d variables_order=EGPCS /app/artisan"
ENV APP_COMMAND="${FRANKEN_CLI} octane:frankenphp --host=0.0.0.0 --port=8000"
ENV APP_USER="docker"

# Set timezone
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# Main dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gnupg curl ca-certificates gosu \
    libavif-bin jpegoptim optipng pngquant gifsicle \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Add PostgreSQL APT repository and install client
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
    && CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME") \
    && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt ${CODENAME}-pgdg main" | tee /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-${POSTGRES_VERSION} \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Add NodeSource APT repository and install Node.js
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user
RUN groupadd --force -g ${GID} docker \
    && useradd -u ${UID} -g docker -d /home/docker -s /bin/bash -m docker

# Create directories and set ownership
RUN mkdir -p /app /config \
    && chown -R docker:docker /app /config

# PHP Configuration
RUN cp ${PHP_INI_DIR}/php.ini-production ${PHP_INI_DIR}/php.ini

# Install PHP extensions
RUN install-php-extensions @composer \
    apcu bcmath exif ffi gd opcache \
    igbinary imagick inotify intl pcntl \
    pdo_pgsql redis sockets uv zip

# Install additional PHP extensions if specified
RUN if [ -n "$PHP_EXTENSIONS" ]; then \
    install-php-extensions $PHP_EXTENSIONS; \
fi

# Strip file capabilities from frankenphp. libcap2-bin is only needed to run
# setcap, so install and purge it within this single layer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && setcap -r /usr/local/bin/frankenphp \
    && apt-get purge -y --auto-remove libcap2-bin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Custom PHP configuration
COPY podman/frankenphp-octane/runtimes/php-production.ini /usr/local/etc/php/conf.d/xx-php-user.ini

# Node.js Configuration
#
# corepack runs as root and respects FrankenPHP's XDG_CONFIG_HOME=/config
# and XDG_DATA_HOME=/data, writing files there as root even though both
# were chowned to "docker" earlier -- re-chown so the "docker" user can
# read them.
RUN npm install -g npm@latest corepack@latest svgo@latest \
    && mkdir -p ${PNPM_HOME}/store \
    && corepack enable && corepack prepare pnpm@latest --activate \
    && pnpm config set store-dir ${PNPM_HOME}/store \
    && chown -R docker:docker ${PNPM_HOME} /config /data

# Entrypoint
COPY --chmod=755 podman/frankenphp-octane/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh

# Clean up unnecessary files and caches to reduce image size
RUN apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy application source
COPY --chown=docker:docker . /app

# Switch to non-root user
USER docker

# Make sure an basic .env file exists
RUN cp .env.example .env

# Install PHP dependencies
RUN --mount=type=cache,target=/home/docker/.composer/cache,uid=${UID},gid=${GID} \
    composer install --prefer-dist --no-dev --optimize-autoloader --no-interaction --no-scripts

# Complete composer setup
RUN composer dump-autoload --optimize

# Generate application key
RUN ${PHP_CLI} key:generate

# Create storage symlink
RUN ${PHP_CLI} storage:link

# Install Node.js dependencies, build frontend assets, then prune
# devDependencies -- all in one layer, since Docker layers are additive and
# pruning in a later layer wouldn't remove devDependencies from the image.
RUN --mount=type=cache,target=/home/docker/.local/share/pnpm/store,uid=${UID},gid=${GID} \
    pnpm install --frozen-lockfile \
    && pnpm build && pnpm build:ssr \
    && pnpm prune --prod

# Remove .env file if it exists
RUN rm -f .env

# Run as root so the entrypoint can renumber the "docker" user to the
# runtime PUID/PGID before dropping privileges
USER root

EXPOSE 6001 8000 13714

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
