# The idle check for hosts without lpod, such as apps set up with
# laravel-installer. With lpod, run "lpod idle enable {{application}}" instead.
# Install one or the other, not both.
[Unit]
Description=Laravel idle check

[Service]
Type=oneshot
TimeoutStartSec=50
ExecCondition=/usr/bin/test {{ondemand}} = yes
ExecCondition={{systemctl}} --quiet is-active {{application}}-ondemand.socket
ExecCondition=/bin/sh -c 'case "$$({{systemctl}} is-active {{application}}.service)" in inactive|failed) exit 0;; *) exit 1;; esac'
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}-schedule.service || { echo "The scheduler of {{application}} is still running."; exit 1; }'
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}-queue.service || podman exec systemd-{{application}}-queue php -d variables_order=EGPCS /app/artisan podman:idle || { echo "{{application}} has work in progress, keeping its workers running."; exit 1; }'
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}-horizon.service || podman exec systemd-{{application}}-horizon php -d variables_order=EGPCS /app/artisan podman:idle || { echo "{{application}} has work in progress, keeping its workers running."; exit 1; }'
ExecCondition=/bin/sh -c 'case "$$({{systemctl}} is-active {{application}}.service)" in inactive|failed) exit 0;; *) exit 1;; esac'
ExecStart=-{{systemctl}} stop --no-block {{application}}-queue.service
ExecStart=-{{systemctl}} stop --no-block {{application}}-horizon.service
ExecStart=-{{systemctl}} stop --no-block {{application}}-schedule.timer
