[Unit]
Description=Laravel idle check

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'scope=--user; [ "$$(id -u)" -ne 0 ] || scope=; [ {{ondemand}} = yes ] && ! systemctl $$scope --quiet is-active {{application}}.service'
ExecStart=/bin/sh -c 'scope=--user; [ "$$(id -u)" -ne 0 ] || scope=; busy=0; for worker in queue horizon; do systemctl $$scope --quiet is-active {{application}}-$$worker.service || continue; if podman exec systemd-{{application}}-$$worker php -d variables_order=EGPCS /app/artisan podman:idle --service=$$worker; then systemctl $$scope stop {{application}}-$$worker.service; else busy=1; fi; done; [ $$busy -eq 1 ] || ! systemctl $$scope --quiet is-active {{application}}-schedule.timer || systemctl $$scope stop {{application}}-schedule.timer; exit 0'
