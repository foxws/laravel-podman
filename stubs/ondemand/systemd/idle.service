[Unit]
Description=Laravel idle check

[Service]
Type=oneshot
ExecCondition=/usr/bin/test {{ondemand}} = yes
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}.service'
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}-{{ondemandWorker}}.service || exec podman exec systemd-{{application}}-{{ondemandWorker}} php -d variables_order=EGPCS /app/artisan podman:idle'
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}.service'
ExecStart=-{{systemctl}} stop {{application}}-{{ondemandWorker}}.service
ExecStart=-{{systemctl}} stop {{application}}-schedule.timer
