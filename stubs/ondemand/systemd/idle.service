# Deprecated: lpod v2.2.0 and later run this check with "lpod idle enable {{application}}".
# Install one or the other, not both. Removed in the next major version.
[Unit]
Description=Laravel idle check

[Service]
Type=oneshot
TimeoutStartSec=50
ExecCondition=/usr/bin/test {{ondemand}} = yes
ExecCondition=/bin/sh -c 'case "$$({{systemctl}} is-active {{application}}.service)" in inactive|failed) exit 0;; *) exit 1;; esac'
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}-schedule.service'
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}-queue.service || exec podman exec systemd-{{application}}-queue php -d variables_order=EGPCS /app/artisan podman:idle'
ExecCondition=/bin/sh -c '! {{systemctl}} --quiet is-active {{application}}-horizon.service || exec podman exec systemd-{{application}}-horizon php -d variables_order=EGPCS /app/artisan podman:idle'
ExecCondition=/bin/sh -c 'case "$$({{systemctl}} is-active {{application}}.service)" in inactive|failed) exit 0;; *) exit 1;; esac'
ExecStart=-{{systemctl}} stop --no-block {{application}}-queue.service
ExecStart=-{{systemctl}} stop --no-block {{application}}-horizon.service
ExecStart=-{{systemctl}} stop --no-block {{application}}-schedule.timer
