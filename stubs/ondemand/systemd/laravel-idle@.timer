# The idle check's timer, shared by every on-demand app on this host:
# "laravel-idle@my-app.timer" checks "my-app". Started by the app's
# on-demand socket's Wants= line, and stopped with it, so installing the
# socket is enough. It has no install section to enable.
[Unit]
Description=Laravel idle check timer for %i
PartOf=%i-ondemand.socket

#
# The exact second doesn't matter, so systemd may delay it by up to 15
# seconds to share a wake-up with other timers. It fires between :10 and
# :25, clear of the scheduler at :00 and its wake-ups at :30.
[Timer]
OnCalendar=*-*-* *:*:10
AccuracySec=15s
