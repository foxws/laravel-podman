# FileName={{application}}-mongodb
[Unit]
Description=MongoDB container
StopWhenUnneeded={{ondemand}}

[Container]
Image=docker.io/library/mongo:8
AutoUpdate=registry
Secret={{application}}-mongodb-user,type=env,target=MONGO_INITDB_ROOT_USERNAME
Secret={{application}}-mongodb-password,type=env,target=MONGO_INITDB_ROOT_PASSWORD
Volume={{application}}-mongodb.volume:/data/db:rw,Z,U
Network={{application}}.network
ExposeHostPort=27017
Notify=healthy
HealthStartupCmd=mongosh --quiet --eval 'db.runCommand({ping: 1}).ok'
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=mongosh --quiet --eval 'db.runCommand({ping: 1}).ok'
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName={{application}}-mongodb
[Volume]
Label={{application}}-mongodb
VolumeName=systemd-{{application}}-mongodb
