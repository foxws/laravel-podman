# FileName={{application}}-redis
[Unit]
Description=Redis container
StopWhenUnneeded={{ondemand}}

[Container]
Image=docker.io/library/redis:8
AutoUpdate=registry
Exec=redis-server --save 60 1 --maxmemory-policy noeviction --loglevel warning
Volume={{application}}-redis.volume:/data:rw,Z,U
Network={{application}}.network
ExposeHostPort=6379
Notify=healthy
HealthStartupCmd=redis-cli ping
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=redis-cli ping
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName={{application}}-redis
[Volume]
Label={{application}}-redis
VolumeName=systemd-{{application}}-redis
