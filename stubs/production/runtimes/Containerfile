# Built on ghcr.io/foxws/laravel-frankenphp, which has FrankenPHP, the PHP
# extensions, Composer, Node.js, pnpm, the PostgreSQL client and the
# "docker" user, so building the app only copies it in and builds it. Pass
# --build-arg RUNTIME_IMAGE=ghcr.io/foxws/laravel-frankenphp:php-8.4 (or add
# it under [Build] as BuildArg=) for PHP 8.4. See docs/runtime.md.
ARG RUNTIME_IMAGE=ghcr.io/foxws/laravel-frankenphp:php-8.5

FROM ${RUNTIME_IMAGE}

ARG UID=1000
ARG GID=1000
ARG PHP_EXTENSIONS=""

WORKDIR /app

ENV PHP_CLI="php -d variables_order=EGPCS /app/artisan"
ENV APP_COMMAND="${PHP_CLI} octane:frankenphp --host=0.0.0.0 --port=8000"

# The runtime image's "docker" user is 1000:1000. Renumber it when building
# with another UID/GID, so the cache mounts below line up.
RUN if [ "$(id -u docker)" != "${UID}" ] || [ "$(id -g docker)" != "${GID}" ]; then \
        groupmod -o -g "${GID}" docker \
        && usermod -o -u "${UID}" -g "${GID}" docker \
        && chown -R docker:docker /home/docker /app /config /data; \
    fi

# Install additional PHP extensions if specified
RUN if [ -n "$PHP_EXTENSIONS" ]; then \
    install-php-extensions $PHP_EXTENSIONS; \
fi

# Custom PHP configuration
COPY podman/production/runtimes/php-production.ini ${PHP_INI_DIR}/conf.d/xx-php-user.ini

# Entrypoint
COPY --chmod=755 podman/production/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh

# Copy application source
COPY --chown=docker:docker . /app

# Switch to non-root user
USER docker

# Make sure an basic .env file exists
RUN cp .env.example .env

# Install PHP dependencies
RUN --mount=type=cache,target=/home/docker/.cache/composer,uid=${UID},gid=${GID} \
    composer install --prefer-dist --no-dev --optimize-autoloader --no-interaction --no-scripts

# Complete composer setup
RUN composer dump-autoload --optimize

# Generate a throwaway application key: the frontend build can boot Laravel
# (e.g. Wayfinder runs "php artisan wayfinder:generate"), which needs one.
# The build-time .env is removed below; the real key comes from the runtime
# .env.
RUN ${PHP_CLI} key:generate

# Create storage symlink
RUN ${PHP_CLI} storage:link

# Install Node.js dependencies, build frontend assets, then prune
# devDependencies -- all in one layer, since Docker layers are additive and
# pruning in a later layer wouldn't remove devDependencies from the image.
RUN --mount=type=cache,target=/home/docker/.local/share/pnpm/store,uid=${UID},gid=${GID} \
    --mount=type=cache,target=/home/docker/.cache/pnpm,uid=${UID},gid=${GID} \
    pnpm install --frozen-lockfile \
    && pnpm build && pnpm build:ssr \
    && pnpm prune --prod

# Remove .env file if it exists
RUN rm -f .env

# Run as root so the entrypoint can renumber the "docker" user to the
# runtime PUID/PGID before dropping privileges
USER root

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
