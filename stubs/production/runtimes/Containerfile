# Three stages: "frankenphp" compiles a static FrankenPHP, "runtime" puts it
# on Debian, and the app is built on RUNTIME_IMAGE. That defaults to the
# runtime stage as published by laravel-podman, so app builds skip the first
# two stages. To build the runtime yourself, for another PHP version or other
# extensions (PHP_EXTENSIONS, comma-separated; they're compiled into the
# binary), build --target=runtime and pass its tag as RUNTIME_IMAGE.
ARG FRANKENPHP_VERSION=1.13.4
ARG DEBIAN_VERSION=trixie
ARG RUNTIME_IMAGE=ghcr.io/foxws/laravel-frankenphp:php-8.5

FROM docker.io/dunglas/frankenphp:static-builder-gnu-${FRANKENPHP_VERSION} AS frankenphp

ARG PHP_VERSION=8.5
ARG PHP_EXTENSIONS="apcu,bcmath,ctype,curl,dom,exif,fileinfo,filter,gd,iconv,igbinary,imagick,intl,mbregex,mbstring,mysqlnd,opcache,openssl,password-argon2,pcntl,pdo,pdo_mysql,pdo_pgsql,pdo_sqlite,phar,posix,readline,redis,session,simplexml,sockets,sodium,sqlite3,tokenizer,uv,xml,xmlreader,xmlwriter,zip,zlib"

# The glibc build links against the builder's glibc 2.28, so it runs on any
# newer Debian. The build runs ./build-static.sh, the builder's default command.
# It looks up most sources through the GitHub API, which allows 60 requests an
# hour without a token: pass one with --secret id=github_token,env=GITHUB_TOKEN
# (or src=<file>) to raise that. It isn't stored in the image.
RUN --mount=type=secret,id=github_token,required=false \
    if [ -s /run/secrets/github_token ]; then export GITHUB_TOKEN="$(cat /run/secrets/github_token)"; fi \
    && PHP_VERSION="${PHP_VERSION}" PHP_EXTENSIONS="${PHP_EXTENSIONS}" OUTPUT_DIR=/output ./build-static.sh \
    && mv /output/frankenphp-linux-* /output/frankenphp

# The static build has no php.ini of its own. EGPCS fills $_ENV from the
# container's environment.
ADD https://raw.githubusercontent.com/php/php-src/PHP-${PHP_VERSION}/php.ini-production /output/php.ini
RUN sed -i 's/^variables_order = .*/variables_order = "EGPCS"/' /output/php.ini \
    && grep -q '^variables_order = "EGPCS"' /output/php.ini

FROM docker.io/library/debian:${DEBIAN_VERSION}-slim AS runtime

ARG UID=1000
ARG GID=1000

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV XDG_CONFIG_HOME=/config
ENV XDG_DATA_HOME=/data
ENV PHP_BINARY=/usr/local/bin/php
ENV PHP_INI_DIR=/etc/frankenphp
ENV APP_USER="docker"

# Main dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gosu tzdata libmimalloc3 \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# mimalloc, off by default. FrankenPHP suggests it for glibc builds under
# heavy concurrency: set LD_PRELOAD=/usr/local/lib/libmimalloc.so on the
# containers that should use it.
RUN ln -s "$(dpkg -L libmimalloc3 | grep '/libmimalloc\.so\.3$')" /usr/local/lib/libmimalloc.so \
    && test -e /usr/local/lib/libmimalloc.so

# Set timezone
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# The static build looks for its CA certificates under OPENSSLDIR=/etc/ssl
RUN ln -s certs/ca-certificates.crt /etc/ssl/cert.pem

# FrankenPHP, the "php" command running its php-cli, and Composer
COPY --from=frankenphp /output/frankenphp /usr/local/bin/frankenphp
COPY --from=frankenphp /output/php.ini ${PHP_INI_DIR}/php.ini
COPY --chmod=755 podman/production/runtimes/php /usr/local/bin/php
COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/local/bin/composer

RUN mkdir -p ${PHP_INI_DIR}/php.d

# Create non-root user
RUN groupadd --force -g ${GID} docker \
    && useradd -u ${UID} -g docker -d /home/docker -s /bin/bash -m docker

# Create directories and set ownership
RUN mkdir -p /app /config /data \
    && chown -R docker:docker /app /config /data

FROM ${RUNTIME_IMAGE} AS production

ARG UID=1000
ARG GID=1000
ARG NODE_VERSION=26
ARG POSTGRES_VERSION=18

WORKDIR /app

ENV PNPM_HOME="/home/docker/.local/share/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"
ENV PHP_CLI="php /app/artisan"
ENV APP_COMMAND="${PHP_CLI} octane:frankenphp --host=0.0.0.0 --port=8000"

# Main dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gnupg \
    libavif-bin jpegoptim optipng pngquant gifsicle \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Add PostgreSQL APT repository and install client
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
    && CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME") \
    && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt ${CODENAME}-pgdg main" | tee /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-${POSTGRES_VERSION} \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Add NodeSource APT repository and install Node.js
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Custom PHP configuration
COPY podman/production/runtimes/php-production.ini ${PHP_INI_DIR}/php.d/xx-php-user.ini

# Node.js Configuration
#
# pnpm runs as root and respects the runtime's XDG_CONFIG_HOME=/config
# and XDG_DATA_HOME=/data, writing files there as root even though the
# runtime image chowned both to "docker" -- re-chown so the "docker" user
# can read them.
RUN npm install -g npm@latest pnpm@latest svgo@latest \
    && mkdir -p ${PNPM_HOME}/store \
    && pnpm config set store-dir ${PNPM_HOME}/store \
    && chown -R docker:docker ${PNPM_HOME} /config /data

# Entrypoint
COPY --chmod=755 podman/production/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh

# Copy application source
COPY --chown=docker:docker . /app

# Switch to non-root user
USER docker

# Make sure an basic .env file exists
RUN cp .env.example .env

# Install PHP dependencies
RUN --mount=type=cache,target=/home/docker/.composer/cache,uid=${UID},gid=${GID} \
    composer install --prefer-dist --no-dev --optimize-autoloader --no-interaction --no-scripts

# Complete composer setup
RUN composer dump-autoload --optimize

# Generate a throwaway application key: the frontend build can boot Laravel
# (e.g. Wayfinder runs "php artisan wayfinder:generate"), which needs one.
# The build-time .env is removed below; the real key comes from the runtime
# .env.
RUN ${PHP_CLI} key:generate

# Create storage symlink
RUN ${PHP_CLI} storage:link

# Install Node.js dependencies, build frontend assets, then prune
# devDependencies -- all in one layer, since Docker layers are additive and
# pruning in a later layer wouldn't remove devDependencies from the image.
RUN --mount=type=cache,target=/home/docker/.local/share/pnpm/store,uid=${UID},gid=${GID} \
    pnpm install --frozen-lockfile \
    && pnpm build && pnpm build:ssr \
    && pnpm prune --prod

# Remove .env file if it exists
RUN rm -f .env

# Run as root so the entrypoint can renumber the "docker" user to the
# runtime PUID/PGID before dropping privileges
USER root

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
