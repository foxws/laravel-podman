# Static FrankenPHP build, as the base image for the production preset.
# Pass --build-arg FRANKENPHP_VERSION=... or PHP_VERSION=... for another
# version, and PHP_EXTENSIONS=... for another (comma-separated) extension
# list. Extensions can't be added later: they're compiled into the binary.
ARG FRANKENPHP_VERSION=1.13.4
ARG DEBIAN_VERSION=trixie

FROM docker.io/dunglas/frankenphp:static-builder-gnu-${FRANKENPHP_VERSION} AS frankenphp

ARG PHP_VERSION=8.5
ARG PHP_EXTENSIONS="apcu,bcmath,ctype,curl,dom,exif,fileinfo,filter,gd,iconv,igbinary,imagick,intl,mbregex,mbstring,mysqlnd,opcache,openssl,password-argon2,pcntl,pdo,pdo_mysql,pdo_pgsql,pdo_sqlite,phar,posix,readline,redis,session,simplexml,sockets,sodium,sqlite3,tokenizer,uv,xml,xmlreader,xmlwriter,zip,zlib"

# The glibc build links against the builder's glibc 2.28, so it runs on any
# newer Debian. The build runs ./build-static.sh, the builder's default command.
RUN PHP_VERSION="${PHP_VERSION}" PHP_EXTENSIONS="${PHP_EXTENSIONS}" OUTPUT_DIR=/output ./build-static.sh \
    && mv /output/frankenphp-linux-* /output/frankenphp

# The static build has no php.ini of its own
ADD https://raw.githubusercontent.com/php/php-src/PHP-${PHP_VERSION}/php.ini-production /output/php.ini

FROM docker.io/library/debian:${DEBIAN_VERSION}-slim AS runtime

ARG UID=1000
ARG GID=1000

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV XDG_CONFIG_HOME=/config
ENV XDG_DATA_HOME=/data
ENV PHP_BINARY=/usr/local/bin/php
ENV PHP_INI_DIR=/etc/frankenphp
ENV APP_USER="docker"

# Main dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gosu tzdata \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Set timezone
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# The static build looks for its CA certificates under OPENSSLDIR=/etc/ssl
RUN ln -s certs/ca-certificates.crt /etc/ssl/cert.pem

# FrankenPHP, the "php" command running its php-cli, and Composer
COPY --from=frankenphp /output/frankenphp /usr/local/bin/frankenphp
COPY --from=frankenphp /output/php.ini ${PHP_INI_DIR}/php.ini
COPY --chmod=755 podman/runtime/runtimes/php /usr/local/bin/php
COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/local/bin/composer

RUN mkdir -p ${PHP_INI_DIR}/php.d

# Create non-root user
RUN groupadd --force -g ${GID} docker \
    && useradd -u ${UID} -g docker -d /home/docker -s /bin/bash -m docker

# Create directories and set ownership
RUN mkdir -p /app /config /data \
    && chown -R docker:docker /app /config /data
